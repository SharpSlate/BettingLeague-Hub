{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": [
      "node",
      "vite/client"
    ],
    "paths": {
      "@rules": [
        "./supabase/functions/_shared/rules/index.ts"
      ]
    }
  },
  "include": [
    "supabase/functions/**/*.ts",
    "supabase/tests/**/*.ts",
    "scripts/**/*.ts",
    "web/src/**/*.ts",
    "web/src/**/*.tsx",
    "web/*.ts",
    "*.ts"
  ]
}
