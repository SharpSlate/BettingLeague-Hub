{
  "name": "baltimore-degenerates",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:start": "scripts/local-postgres.sh start",
    "db:stop": "scripts/local-postgres.sh stop",
    "dev": "vite --config web/vite.config.ts",
    "dev:demo": "VITE_DEMO=1 vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "build:demo": "VITE_DEMO=1 vite build --config web/vite.config.ts",
    "build:example": "VITE_DEMO=public vite build --config web/vite.config.ts --outDir dist/demo",
    "preview": "vite preview --config web/vite.config.ts"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "pg": "^8.23.0",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  }
}
